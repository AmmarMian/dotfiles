# Allow-list: everything in ~/.config is ignored unless listed below.
# Add a new tool with:  !toolname/
/*
!.gitignore
!README.md
!install.sh
!nvim/
!zsh/
!git/
!btop/
!atuin/
!restic/
!ipython-profile/

# Machine-local files inside allowed dirs
zsh/local.zsh
zsh/machine.zsh
zsh/.zsh_history*
zsh/.zcompdump*
zsh/.zsh_sessions/
git/local
restic/config.sh
restic/paths.txt
atuin/*
!atuin/config.toml
