#!/usr/bin/env bash
# backup — restic backups of this Mac to a NAS and a USB stick.
# Run `backup help` for the commands. Settings live in config.sh next to this file.
set -uo pipefail

DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd -P)"
CONFIG="$DIR/config.sh"
B="$DIR/backup.sh"
STATE="$HOME/.local/state/restic"
LOG="$HOME/Library/Logs/restic-backup.log"
LABEL="local.restic-nas"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
VERSION="1.0"

# ── output helpers ──────────────────────────────────────────────────────────
if [[ -t 1 ]]; then B1=$'\e[1m' DIM=$'\e[2m' GRN=$'\e[32m' RED=$'\e[31m' YEL=$'\e[33m' OFF=$'\e[0m'
else B1="" DIM="" GRN="" RED="" YEL="" OFF=""; fi
h()    { printf '\n%s%s%s\n' "$B1" "$*" "$OFF"; }
kv()   { printf '  %-18s %s\n' "$1" "$2"; }
ok()   { printf '  %s✓%s %s\n' "$GRN" "$OFF" "$*"; }
bad()  { printf '  %s✗%s %s\n' "$RED" "$OFF" "$*"; FAILED=1; }
warn() { printf '  %s!%s %s\n' "$YEL" "$OFF" "$*"; }
die()  { printf '%serror:%s %s\n' "$RED" "$OFF" "$*" >&2; exit 1; }
tilde(){ local s out=(); for s in "$@"; do out+=("${s/#$HOME/~}"); done; printf "%s" "${out[*]}"; }

load_config() {
  [[ -f $CONFIG ]] || die "no config: $CONFIG (copy config.example.sh to config.sh and edit it)"
  # shellcheck source=config.example.sh
  source "$CONFIG"
}

nas_up()   { /usr/bin/nc -z -G 3 "${NAS_CHECK%:*}" "${NAS_CHECK##*:}" >/dev/null 2>&1; }
stick_up() { [[ -d $STICK_REPO ]]; }
names()    { local p out=(); for p in "$@"; do out+=("${p##*/}"); done; echo "${out[*]}"; }
PATHS_FILE=""
paths_for() {  # paths_for nas|stick → prints one folder per line (same rules as backup.sh)
  PATHS_FILE="${PATHS_FILE:-$DIR/paths.txt}"
  if [[ -f $PATHS_FILE ]]; then
    local where p
    while read -r where p; do
      [[ -z $where || $where == \#* ]] && continue
      [[ $where == both || $where == "$1" ]] && echo "${p/#\~/$HOME}"
    done < "$PATHS_FILE"
  else
    printf '%s\n' "${WORK_PATHS[@]}"; [[ $1 == stick ]] && printf '%s\n' "${STICK_EXTRA_PATHS[@]}"
  fi
  return 0
}
list_for() { local a=(); while IFS= read -r l; do a+=("$l"); done < <(paths_for "$1"); printf '%s\n' "${a[@]}"; }
# restic on a repository. stdin from /dev/null: restic must never see the terminal,
# otherwise it hands the tty to its ssh child and a concurrent fzf gets suspended.
r()        { "$B" "$1" -- "${@:2}" < /dev/null; }
last_of()  { local ts; ts=$(cat "$STATE/last-$1" 2>/dev/null || echo 0); (( ts > 0 )) && date -r "$ts" '+%Y-%m-%d %H:%M' || echo never; }
job_state(){ launchctl print "gui/$(id -u)/$LABEL" >/dev/null 2>&1 && echo loaded || echo "not installed"; }

# common options: --from nas|stick, --at YYYY-MM-DD, --all, --to DIR, -n N, -f
FROM="" AT="" ALL=0 TO="" N=30 FOLLOW=0 ONLY="" ARGS=()
parse_opts() {
  while (($#)); do
    case $1 in
      --from) FROM=${2:?--from needs nas or stick}; shift 2 ;;
      --at)   AT=${2:?--at needs a date YYYY-MM-DD}; shift 2 ;;
      --to)   TO=${2:?--to needs a folder}; shift 2 ;;
      --only) ONLY=${2:?--only needs nas or stick}; shift 2 ;;
      --all)  ALL=1; shift ;;
      -n)     N=${2:?}; shift 2 ;;
      -f)     FOLLOW=1; shift ;;
      -h|--help) cmd_help "$CMD"; exit 0 ;;
      -*)     die "unknown option $1 (see: backup help $CMD)" ;;
      *)      ARGS+=("$1"); shift ;;
    esac
  done
  [[ -z $FROM || $FROM == nas || $FROM == stick ]] || die "--from must be nas or stick"
  [[ -z $ONLY || $ONLY == nas || $ONLY == stick ]] || die "--only must be nas or stick"
}
pick_from() {
  if [[ -n $FROM ]]; then echo "$FROM"; elif nas_up; then echo nas; elif stick_up; then echo stick
  else die "neither the NAS (${NAS_CHECK}) nor the stick ($STICK_VOLUME) is reachable"; fi
}
snap_for() {   # latest snapshot on or before --at DATE, else "latest"
  [[ -z $AT ]] && { echo latest; return; }
  r "$1" snapshots --json 2>/dev/null | /usr/bin/python3 -I -c '
import sys, json
s = [x for x in json.load(sys.stdin) if x["time"][:10] <= sys.argv[1]]
print(max(s, key=lambda x: x["time"])["short_id"] if s else "")' "$AT"
}
abspath() { /usr/bin/python3 -I -c 'import os,sys; print(os.path.abspath(os.path.expanduser(sys.argv[1])))' "$1"; }

# ── commands ────────────────────────────────────────────────────────────────
cmd_status() {
  load_config
  printf '\n%s%-7s %-11s %-18s %-10s %s%s\n' "$B1" WHERE REACHABLE "LAST BACKUP" SNAPSHOTS CONTAINS "$OFF"
  local t up n what
  for t in nas stick; do
    up=no; if [[ $t == nas ]]; then nas_up && up=yes; else stick_up && up=yes; fi
    n="-"; [[ $up == yes ]] && n=$(r $t snapshots --json 2>/dev/null | /usr/bin/python3 -I -c 'import sys,json; print(len(json.load(sys.stdin)))' 2>/dev/null || echo "?")
    what=$(paths_for $t | while IFS= read -r p; do printf '%s ' "${p##*/}"; done)
    printf '%-7s %-11s %-18s %-10s %s\n' "$t" "$up" "$(last_of $t)" "$n" "$what"
  done
  for t in nas stick; do
    [[ -f $STATE/progress-$t.json ]] || continue
    /usr/bin/python3 -I - "$STATE/progress-$t.json" "$t" <<'PY'
import sys, json, time
m = json.load(open(sys.argv[1])); G = 2**30
if time.time() - m.get("updated", 0) > 300:
    print(f"\n{sys.argv[2]}: a backup was interrupted (no progress for 5+ min); it will be retried."); sys.exit()
rem = m.get("seconds_remaining"); eta = f", ~{rem//60} min left" if rem else ""
print(f"\n▶ {sys.argv[2]} backup in progress: {100*m.get('percent_done',0):.0f}% "
      f"({m.get('bytes_done',0)/G:.1f} / {m.get('total_bytes',0)/G:.1f} GB, "
      f"{m.get('files_done',0)} / {m.get('total_files',0)} files{eta})")
PY
  done
  echo
  echo "Scheduled NAS backup: $(job_state) (daily when reachable). Stick: backup stick."
  [[ -n ${STATUS_NOTE:-} ]] && echo "$STATUS_NOTE"
  [[ -n ${MAP_FILE:-} ]] && echo "Where is what: $(tilde "$MAP_FILE")"
  return 0
}

cmd_config() {
  load_config
  [[ ${ARGS[0]:-} == edit ]] && exec "${EDITOR:-vi}" "$CONFIG"
  h "Files"
  kv "config"       "$(tilde "$CONFIG")   (edit: backup config edit)"
  kv "template"     "$(tilde "$DIR/config.example.sh")"
  kv "excludes"     "$(tilde "$DIR/excludes.txt")"
  kv "log"          "$(tilde "$LOG")"
  kv "state"        "$(tilde "$STATE")/"
  kv "scripts"      "$(tilde "$DIR")/"
  h "NAS"
  kv "repository"   "sftp:$NAS_SSH:$NAS_REPO"
  kv "ssh alias"    "$NAS_SSH  ($(ssh -G "$NAS_SSH" 2>/dev/null | awk '/^user /{u=$2} /^hostname /{h=$2} END{print u"@"h}'), see ~/.ssh/config)"
  kv "reachability" "$NAS_CHECK"
  kv "backs up"     "$(paths_for nas | while IFS= read -r p; do printf '%s ' "${p/#$HOME/~}"; done)"
  h "Stick"
  kv "volume"       "$STICK_VOLUME"
  kv "repository"   "$STICK_REPO"
  kv "backs up"     "$(paths_for stick | while IFS= read -r p; do printf '%s ' "${p/#$HOME/~}"; done)"
  kv "folder list"  "$(tilde "${PATHS_FILE:-$DIR/paths.txt}")   (backup paths · add · remove)"
  h "Policy"
  kv "retention"    "${KEEP[*]}"
  kv "schedule"     "NAS: hourly check, backup if last >24h ($(job_state); $(tilde "$PLIST"))"
  kv "maintenance"  "weekly prune + check of 5% of the data"
  kv "reminders"    "shell warns after ${REMIND_DAYS_NAS:-3} days (NAS) / ${REMIND_DAYS_STICK:-14} days (stick)"
  kv "password"     "macOS Keychain, service \"${KEYCHAIN_SERVICE:-restic-backup}\", account \"$USER\""
  kv "restic"       "$({ "${HOME}/.local/bin/restic" version 2>/dev/null || restic version 2>/dev/null; } | awk '{print $1, $2}')"
  [[ -n ${MAP_FILE:-} ]] && { h "Map"; kv "where is what" "$(tilde "$MAP_FILE")"; }
  echo
}

cmd_doctor() {
  FAILED=0
  h "Checks"
  if [[ -x $HOME/.local/bin/restic ]] || command -v restic >/dev/null; then ok "restic installed"; else bad "restic not found"; fi
  if [[ -f $CONFIG ]]; then ok "config: $(tilde "$CONFIG")"; source "$CONFIG"; else bad "no config.sh"; echo; return 1; fi
  if security find-generic-password -s "${KEYCHAIN_SERVICE:-restic-backup}" -a "$USER" >/dev/null 2>&1; then ok "password in Keychain"
  else bad "no Keychain item \"${KEYCHAIN_SERVICE:-restic-backup}\""; fi
  if nas_up; then
    ok "NAS reachable ($NAS_CHECK)"
    if ssh -n -o BatchMode=yes -o ConnectTimeout=8 -o IdentityAgent=none "$NAS_SSH" true 2>/dev/null; then ok "ssh $NAS_SSH works without the agent (survives reboots)"
    else bad "ssh $NAS_SSH needs the agent — run: ssh-add --apple-use-keychain <key>"; fi
    if r nas cat config >/dev/null 2>&1; then ok "NAS repository opens"; else bad "cannot open NAS repository"; fi
  else warn "NAS not reachable now ($NAS_CHECK) — VPN?"; fi
  if stick_up; then
    if r stick cat config >/dev/null 2>&1; then ok "stick repository opens"; else bad "cannot open stick repository"; fi
  else warn "stick not plugged in ($STICK_VOLUME)"; fi
  if [[ $(job_state) == loaded ]]; then ok "scheduled job $LABEL loaded"; else bad "scheduled job not installed — run $(tilde "$DIR")/install.sh"; fi
  local t last max
  for t in nas stick; do
    max=${REMIND_DAYS_NAS:-3}; [[ $t == stick ]] && max=${REMIND_DAYS_STICK:-14}
    last=$(cat "$STATE/last-$t" 2>/dev/null || echo 0)
    if (( last == 0 )); then warn "$t: never backed up"
    elif (( ($(date +%s) - last) / 86400 > max )); then warn "$t: last backup $(last_of $t), older than $max days"
    else ok "$t: last backup $(last_of $t)"; fi
  done
  if grep -q 'BACKUP FAILED\|MAINTENANCE PROBLEM' <(tail -200 "$LOG" 2>/dev/null); then warn "recent failure in the log — backup log"; fi
  echo; return $FAILED
}

cmd_now()   { load_config; "$B" "${ARGS[0]:-nas}"; }

cmd_paths() {
  load_config; PATHS_FILE="${PATHS_FILE:-$DIR/paths.txt}"
  [[ -f $PATHS_FILE ]] || die "no $(tilde "$PATHS_FILE") (folders come from config.sh arrays)"
  printf '\n%s%-6s %-6s %-8s %s%s\n' "$B1" NAS STICK SIZE FOLDER "$OFF"
  local where p full n s
  while read -r where p; do
    [[ -z $where || $where == \#* ]] && continue
    full=${p/#\~/$HOME}
    if [[ -e $full ]]; then s=$(du -sh "$full" 2>/dev/null | cut -f1); else s="missing"; fi
    n=yes; [[ $where == stick ]] && n=-; local k=yes; [[ $where == nas ]] && k=-
    printf '%-6s %-6s %-8s %s\n' "$n" "$k" "$s" "$p"
  done < "$PATHS_FILE"
  echo; echo "${DIM}sizes include excluded junk (node_modules, venvs, caches) · file: $(tilde "$PATHS_FILE")${OFF}"
}

cmd_add() {
  load_config; PATHS_FILE="${PATHS_FILE:-$DIR/paths.txt}"
  [[ ${#ARGS[@]} -ge 1 ]] || die "usage: backup add <folder> [--only nas|stick]"
  local full rel where=${ONLY:-both}
  full=$(abspath "${ARGS[0]}"); [[ -d $full ]] || die "not a folder: ${ARGS[0]}"
  rel=${full/#$HOME/\~}
  touch "$PATHS_FILE"
  grep -vE "^[a-z]+[[:space:]]+$(printf '%s' "$rel" | sed 's/[][\.*^$/]/\\&/g')\$" "$PATHS_FILE" > "$PATHS_FILE.tmp"
  printf '%-6s %s\n' "$where" "$rel" >> "$PATHS_FILE.tmp" && mv "$PATHS_FILE.tmp" "$PATHS_FILE"
  echo "added: $rel → $([[ $where == both ]] && echo "NAS + stick" || echo "$where only")  (from the next backup on)"
}

cmd_remove() {
  load_config; PATHS_FILE="${PATHS_FILE:-$DIR/paths.txt}"
  [[ ${#ARGS[@]} -ge 1 ]] || die "usage: backup remove <folder> [--only nas|stick]"
  local full rel where p found=0 out=()
  full=$(abspath "${ARGS[0]}"); rel=${full/#$HOME/\~}
  while IFS= read -r line; do
    read -r where p <<< "$line"
    if [[ -n $where && $where != \#* && $p == "$rel" ]]; then
      found=1
      if [[ -n $ONLY && $where == both ]]; then
        out+=("$(printf '%-6s %s' "$([[ $ONLY == nas ]] && echo stick || echo nas)" "$rel")")
      elif [[ -n $ONLY && $where != "$ONLY" ]]; then out+=("$line")
      fi
      continue
    fi
    out+=("$line")
  done < "$PATHS_FILE"
  [[ $found == 1 ]] || die "$rel is not in the backup list (see: backup paths)"
  printf '%s\n' "${out[@]}" > "$PATHS_FILE.tmp" && mv "$PATHS_FILE.tmp" "$PATHS_FILE"
  echo "removed: $rel${ONLY:+ from $ONLY}. Existing snapshots keep it until retention expires them."
}
cmd_stick() { exec "$DIR/backup-stick"; }
cmd_log()   { [[ $FOLLOW == 1 ]] && exec tail -n "$N" -f "$LOG"; tail -n "$N" "$LOG"; }

cmd_snapshots() { load_config; local f; f=$(pick_from); echo "[$f]"; r "$f" snapshots --compact; }

cmd_find() {
  load_config; [[ ${#ARGS[@]} -ge 1 ]] || die "usage: backup find <pattern> [--all] [--from nas|stick]"
  local f; f=$(pick_from); echo "[$f] searching '${ARGS[0]}' …"
  if [[ $ALL == 1 ]]; then r "$f" find "${ARGS[0]}"; else r "$f" find --snapshot latest "${ARGS[0]}"; fi
}

cmd_ls() {
  load_config; [[ ${#ARGS[@]} -ge 1 ]] || die "usage: backup ls <folder> [--at DATE] [--from nas|stick]"
  local f s p; f=$(pick_from); s=$(snap_for "$f"); [[ -n $s ]] || die "no snapshot on or before $AT"
  p=$(abspath "${ARGS[0]}"); echo "[$f] snapshot $s: $(tilde "$p")"
  r "$f" ls "$s" "$p"
}

restore_from() {  # restore_from <nas|stick> <snapshot> <absolute path>
  local f=$1 s=$2 p=$3 dest
  dest=${TO:-$HOME/Restored/$(date '+%Y-%m-%d_%H%M%S')}
  [[ -e $dest/${p#/} ]] && die "$dest$p already exists — choose another --to"
  echo "[$f] restoring $(tilde "$p") from snapshot $s into $(tilde "$dest") …"
  r "$f" restore "$s" --include "$p" --target "$dest" || exit 1
  echo; echo "Restored to: $(tilde "$dest$p")"
  echo "Nothing was overwritten. Compare, then move back what you need."
  open -R "$dest$p" 2>/dev/null || true
}

cmd_restore() {
  load_config; [[ ${#ARGS[@]} -ge 1 ]] || die "usage: backup restore <path> [--at DATE] [--from nas|stick] [--to DIR]"
  local f s; f=$(pick_from); s=$(snap_for "$f"); [[ -n $s ]] || die "no snapshot on or before $AT"
  restore_from "$f" "$s" "$(abspath "${ARGS[0]}")"
}

versions_of() {  # versions_of <nas|stick> <absolute path> [--tsv]
  local tmp; tmp=$(mktemp -t backup-snaps)
  r "$1" snapshots --json > "$tmp" 2>/dev/null
  r "$1" find --json --long "$2" 2>/dev/null | /usr/bin/python3 -I "$DIR/versions.py" versions "$2" "$tmp" ${3:-}
  local rc=$?; rm -f "$tmp"; return $rc
}

cmd_versions() {
  load_config; [[ ${#ARGS[@]} -ge 1 ]] || die "usage: backup versions <file> [--from nas|stick]"
  local f p; f=$(pick_from); p=$(abspath "${ARGS[0]}")
  echo "[$f] versions of $(tilde "$p"):"
  versions_of "$f" "$p" || exit 1
  echo; echo "${DIM}restore one: backup restore $(tilde "$p") --at <date>   (or: backup search)${OFF}"
}

cmd_search() {
  load_config
  command -v fzf >/dev/null || die "fzf is not installed (brew install fzf)"
  local f snap cache sel p vsel vsnap
  f=$(pick_from)
  snap=$(r "$f" snapshots --json 2>/dev/null | /usr/bin/python3 -I -c '
import sys, json
s = json.load(sys.stdin); print(max(s, key=lambda x: x["time"])["short_id"] if s else "")')
  [[ -n $snap ]] || die "no snapshot in the $f repository"
  cache="$STATE/files-$f-$snap.tsv"
  if [[ ! -s $cache ]]; then
    echo "[$f] indexing snapshot $snap (once per snapshot) …" >&2
    rm -f "$STATE"/files-"$f"-*.tsv
    r "$f" ls --json "$snap" 2>/dev/null | /usr/bin/python3 -I "$DIR/versions.py" list "$cache" || die "could not list snapshot $snap"
  fi
  sel=$(fzf --delimiter=$'\t' --with-nth=1 --height=80% --reverse --query="${ARGS[0]:-}" \
          --prompt="[$f] file > " --header="latest backup $snap · Enter: show versions · Esc: quit" \
          --preview='printf "%s\nsize:      %s\nmodified:  %s\n" {1} {3} {4}' --preview-window=down,3,wrap < "$cache") || return 0
  p=$(cut -f2 <<< "$sel")
  echo "[$f] looking for every version of $(tilde "$p") …" >&2
  local vlist; vlist=$(versions_of "$f" "$p" --tsv) || die "no version found"   # finish restic first …
  vsel=$(fzf --delimiter=$'\t' --with-nth=2 --height=40% --reverse \
          --prompt="version > " --header="$(tilde "$p") · Enter: restore into ~/Restored · Esc: quit" \
          <<< "$vlist") || return 0                                           # … then open the menu
  vsnap=$(cut -f1 <<< "$vsel")
  restore_from "$f" "$vsnap" "$p"
}

cmd_help() {
  case ${1:-} in
    status)    echo "backup status — reachability, last backup, snapshot count and live progress for each destination." ;;
    config)    echo "backup config [edit] — show the active settings and where everything is stored; 'edit' opens config.sh." ;;
    doctor)    echo "backup doctor — check restic, config, Keychain password, ssh, repositories, schedule and backup age." ;;
    now)       echo "backup now [nas|stick] — run a backup now (default: nas)." ;;
    stick)     echo "backup stick — back up to the stick, show the result, offer to eject (same as backup-stick)." ;;
    snapshots) echo "backup snapshots [--from nas|stick] — list snapshots." ;;
    find)      echo "backup find <pattern> [--all] [--from nas|stick] — find files by name ('*thesis*.tex'). --all searches every snapshot." ;;
    ls)        echo "backup ls <folder> [--at YYYY-MM-DD] [--from nas|stick] — list a folder as it was in a backup." ;;
    restore)   echo "backup restore <path> [--at YYYY-MM-DD] [--from nas|stick] [--to DIR] — restore into ~/Restored/<date>/ (or DIR). Never overwrites." ;;
    log)       echo "backup log [-n N] [-f] — show the last N lines of the log (-f: follow)." ;;
    search)    echo "backup search [text] [--from nas|stick] — fuzzy-find a file in the latest backup (fzf), pick a version, restore it." ;;
    versions)  echo "backup versions <file> [--from nas|stick] — every distinct version of a file kept in the backups." ;;
    paths)     echo "backup paths — the folders backed up, where to (NAS / stick) and their size." ;;
    add)       echo "backup add <folder> [--only nas|stick] — back up this folder too (default: NAS and stick)." ;;
    remove)    echo "backup remove <folder> [--only nas|stick] — stop backing up a folder (or stop only on one side)." ;;
    *) cat <<EOF
${B1}backup${OFF} $VERSION — restic backups of this Mac (NAS + USB stick)

${B1}Overview${OFF}
  status              destinations, last backup, progress
  config [edit]       active settings and where they are stored
  doctor              check that everything works
  log [-n N] [-f]     backup log

${B1}Back up${OFF}
  now [nas|stick]     back up now (default: nas)
  stick               back up to the stick, then eject
  paths               folders that are backed up
  add <folder>        back up a folder too       [--only nas|stick]
  remove <folder>     stop backing up a folder   [--only nas|stick]

${B1}Find & restore${OFF}
  search [text]       fuzzy-find a file, pick a version, restore (fzf)
  versions <file>     versions of a file kept in the backups
  snapshots           list snapshots
  find <pattern>      find files by name        [--all]
  ls <folder>         browse a folder           [--at DATE]
  restore <path>      restore a file or folder  [--at DATE] [--to DIR]

  Common options: --from nas|stick (default: NAS if reachable, else stick)
  ${DIM}backup help <command> for details · docs: $(tilde "$DIR")/README.md${OFF}
EOF
  esac
}

# ── dispatch ────────────────────────────────────────────────────────────────
CMD=${1:-status}; shift || true
case $CMD in
  -h|--help) CMD=help ;;
  -V|--version) echo "backup $VERSION"; exit 0 ;;
esac
parse_opts "$@"
case $CMD in
  status|config|doctor|now|stick|snapshots|find|ls|restore|log|paths|add|remove|search|versions) "cmd_$CMD" ;;
  help) cmd_help "${ARGS[0]:-}" ;;
  *) die "unknown command '$CMD' (see: backup help)" ;;
esac
