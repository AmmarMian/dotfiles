<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Generated by install.sh (__HOME__ is replaced). Hourly check; backs up to the
     NAS only when the last backup is >24h old and the NAS answers. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>local.restic-nas</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__DIR__/backup.sh</string>
    <string>nas</string>
    <string>--if-due</string>
  </array>
  <key>StartInterval</key><integer>3600</integer>
  <key>RunAtLoad</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/restic-backup-launchd.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/restic-backup-launchd.log</string>
</dict>
</plist>
